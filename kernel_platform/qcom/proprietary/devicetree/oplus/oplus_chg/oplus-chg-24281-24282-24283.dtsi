			//2nd SWD Battery(pack, ATL µçÐ¾
	    		//battery,id = <1>;
			battery1,param_version = <1>;
		    	battery1,max_voltage_uv = <4500000>;
		        battery1,battery_type = <4500 0x0 0x2CA8>;
