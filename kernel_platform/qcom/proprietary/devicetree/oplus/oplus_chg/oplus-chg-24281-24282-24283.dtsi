#include <dt-bindings/iio/qti_power_supply_iio.h>

&thermal_zones {
	soc {
		thermal_soc_cooling_maps: cooling-maps {
			soc_cpu0 {
				cooling-device =
					<&CPU0 (THERMAL_MAX_LIMIT-4)
						(THERMAL_MAX_LIMIT-4)>;
			};

			soc_cpu4 {
				cooling-device =
					<&CPU4 (THERMAL_MAX_LIMIT-4)
						(THERMAL_MAX_LIMIT-4)>;
			};

			/*soc_cpu6 {
				cooling-device = <&cpu6_isolate 1 1>;
			};

			soc_cpu7 {
				cooling-device = <&cpu7_isolate 1 1>;
			};*/
		};
	};
};

&soc {
	oplus,track-charge {
		compatible = "oplus,track-charge";
		track,fast_chg_break_t_thd = <1000>;
		track,general_chg_break_t_thd = <200>;
		track,voocphy_type = <2>;
		track,wired_max_power = <45000>;
		track,wired_fast_chg_scheme = <4>;
		track,gauge_status_ctrl;
		track,nominal_qmax1 = <5166>;
		track,nominal_fcc1 = <4700>;
		track,external_gauge_num = <1>;
	};

	oplus_battery_log: oplus,battery_log {
		compatible = "oplus,battery_log";
		oplus,battery_log_support;
	};
};

&tlmm {
	tlmm_chg_pins: tlmm_chg_pins {
		vib_on_high: vib_on_high {
			mux {
				pins = "gpio100";
				function = "gpio";
			};

			config {
				pins = "gpio100";
				drive-strength = <2>;
				output-high;
			};
		};
		vib_off_low: vib_off_low {
			mux {
				pins = "gpio100";
				function = "gpio";
			};

			config {
				pins = "gpio100";
				drive-strength = <2>;
				output-low;
			};
		};

		rt1711h_int_n: rt1711h_int_n {
			mux {
				pins = "gpio89";
				function = "gpio";
			};

			config {
				pins = "gpio89";
				drive-strength = <2>;
				bias-disable;
			};
		};

		sc6607_chg_int_default: sc6607_chg_int_default {
			mux {
				pins = "gpio32";
				function = "gpio";
			};

			config {
				pins = "gpio32";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se2_i2c_sleep: qupv3_se2_i2c_sleep {
				mux {
					pins = "gpio6", "gpio7";
					function = "gpio";
				};

				config {
					pins = "gpio6", "gpio7";
					drive-strength = <2>;
					bias-no-pull;
					output-high;
				};
		};

		/*split_chg*/
		splitchg_inter_active: splitchg_inter_active {
			mux {
				pins = "gpio32";
				function = "gpio";
			};
			config {
				pins = "gpio32";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		splitchg_inter_sleep: splitchg_inter_sleep {
			mux {
				pins = "gpio32";
				function = "gpio";
			};
			config {
				pins = "gpio32";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		ccdetect_active: ccdetect_active {
			mux {
				pins = "gpio34";
				function = "gpio";
			};
			config {
				pins = "gpio34";
				drive-strength = <2>;
				input-enable;
				//bias-pull-up; /*PULL UP*/
				bias-disable;
			};
		};

		ccdetect_sleep: ccdetect_sleep {
			mux {
				pins = "gpio34";
				function = "gpio";
			};
			config {
				pins = "gpio34";
				drive-strength = <2>;
				//output-low;
				//bias-pull-down; /*PULL DOWN*/
				input-enable;
				bias-disable;
			};
		};
	};
};

&pm6125_vadc {
	pinctrl-0 = <&usbtemp_r_v_chan_default &usbtemp_l_v_chan_default &batt_id_chan_default>;

	usbtemp_r_v_chan {
		reg = <ADC5_GPIO1_100K_PU>;
		label = "usbtemp_r_v_chan";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
	};

	usbtemp_l_v_chan {
		reg = <ADC5_GPIO2_100K_PU>;
		label = "usbtemp_l_v_chan";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
	};

	batt_id_chan {
		reg = <ADC5_GPIO4_100K_PU>;
		label = "batt_id_chan";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,scale-fn-type = <ADC_SCALE_HW_CALIB_DEFAULT>;
	};
};

&pm6125_gpios {
	pm6125_chg_pins: pm6125_chg_pins {
			usbtemp_r_v_chan {
				usbtemp_r_v_chan_default: usbtemp_r_v_chan_default {
					pins = "gpio3";
					bias-high-impedance;
				};
			};

			usbtemp_l_v_chan {
				usbtemp_l_v_chan_default: usbtemp_l_v_chan_default {
					pins = "gpio4";
					bias-high-impedance;
				};
			};

			batt_id_chan {
				batt_id_chan_default: batt_id_chan_default {
					pins = "gpio7";
					bias-high-impedance;
				};
			};
	};
	dischg_enable: dischg_enable {
		pins = "gpio8";
		function = "normal";
		power-source = <0>;
		output-high;
		input-disable;
		qcom,drive-strength = <2>;
	};

	dischg_disable: dischg_disable {
		pins = "gpio8";
		function = "normal";
		power-source = <0>;
		output-low;
		input-disable;
		qcom,drive-strength = <2>;
	};
};

&qupv3_se1_i2c_pins {
	qupv3_se1_i2c_sleep: qupv3_se1_i2c_sleep {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-no-pull;
			output-high;
		};
	};
	qupv3_se1_i2c_pulldown: qupv3_se1_i2c_pulldown {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-pull-down;
			output-low;
		};
	};

	qupv3_se1_i2c_pullup: qupv3_se1_i2c_pullup {
		mux {
			pins = "gpio4", "gpio5";
			function = "gpio";
		};

		config {
			pins = "gpio4", "gpio5";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};
};

&qupv3_se1_i2c {
	status = "okay";
	qcom,clk-freq-out = <100000>;
	pinctrl-names = "default", "sleep", "pulldown", "pullup";
	pinctrl-0 = <&qupv3_se1_i2c_active>;
	pinctrl-1 = <&qupv3_se1_i2c_sleep>;
	pinctrl-2 = <&qupv3_se1_i2c_pulldown>;
	pinctrl-3 = <&qupv3_se1_i2c_pullup>;
	oplus,i2c-auto-suspend-delay-ms = <3000>;
	bq27541-battery@55 {
		status = "okay";
		compatible = "oplus,bq27541-battery";
		reg = <0x55>;
		io-channels = <&pm6125_vadc ADC5_GPIO4_100K_PU>;
		io-channel-names = "batt_id_chan";
		dep-supply = <&pm6125_vadc>;
		oplus,gauge_abnormal_vbatt_max = <4800>;
		oplus,gauge_abnormal_vbatt_min = <2000>;
		oplus,cp_abnormal_fcc_max = <6600>;
		oplus,cp_abnormal_fcc_min = <3000>;
		oplus,cp_abnormal_soh_max = <100>;
		oplus,cp_abnormal_soh_min = <70>;
		oplus,cp_abnormal_qmax_max = <6600>;
		oplus,cp_abnormal_qmax_min = <4000>;
		battery_bqfs_params {
			#include "oplus-bqfs-24281.dtsi"
		};
	};

	sm5602:sm5602@71 {
		compatible = "sm,sm5602g";
		reg = <0x71>;

		sm,en_temp_ex;
		//sm,en_temp_in;
		//sm,en_temp_3rd;
		//sm,en_batt_det;
		sm,iocv_man_mode;
		sm,misc = <0x0800 0x0400>; //ex : 0x0800(Disabled DIS_HARD_RESET)
		sm,aging_ctrl = <0x0121>;
		sm,cycle_cfg = <0x7000>;
		sm,rsns = <5>;
		sm,battery_table_num = <0>;
		sm,param_version = <1>;
		sm,rpara = <0x0>;
		sm,curr_voffset = <0>;
		sm,curr_vslope = <0x8080>;

		//ENABLE_IOCV_ADJ
		sm,enable_iocv_adj;
		sm,iocv_max_adj_level = <0x1F33>;
		sm,iocv_min_adj_level = <0x1d70>;
		sm,ioci_max_adj_level = <0x1000>;
		sm,ioci_min_adj_level = <0xCC>;
		sm,iocv_i_slope = <100>;
		sm,iocv_i_offset = <0>;

		//ENABLE_INSPECTION_TABLE
		sm,enable_inspection_table;

		//ENABLE_TEMBASE_ZDSCON
		sm,enable_tembase_zdscon;
		sm,zdscon_act_temp_gap = <15>;
		sm,t_gap_denom = <5>;
		sm,hminman_t_value_fast = <125>;
		sm,i_gap_denom = <1000>;
		sm,hminman_i_value_fast = <150>;

		//ENABLE_TEMP_AVG
		sm,enable_temp_avg;
		sm,change_temp_time_limit = <1>;

		//ENABLE_NTC_COMPENSATION
		//sm,enable_ntc_compensation;
		sm,rtrace = <4700>;
		sm,overheat_th_deg = <50>;
		sm,cold_th_deg = <0>;

		//ENABLE_LTIM_ACT
		sm,enable_ltim_act;
		sm,ltim_act_temp_gap = <24>;
		sm,ltim_i_limit = <1500>;
		sm,ltim_factor = <42>;
		sm,ltim_denom = <130>;
		sm,ltim_min = <0xA>;

		//ENABLE_HCIC_ACT
		sm,enable_hcic_act;
		sm,hcic_min = <4000>;
		sm,hcic_factor = <2>;
		sm,hcic_denom = <200>;

		//ENABLE_HCRSM_MODE
		//sm,enable_hcrsm_mode;
		sm,hcrsm_volt = <4450>;
		sm,hcrsm_curr = <1750>;
		sm,hcrsm_min_soc = <900>;

		//CHECK_ABNORMAL_TABLE
		sm,enable_check_abnormal_table;

		battery_params {
			//1st NVT Battery( pack, liwon µçÐ¾
		    	battery,id = <0>;
			battery0,param_version = <1>;
		    	battery0,max_voltage_uv = <4500000>;
		        battery0,battery_type = <4500 0x0 0x2C20>;
		    	battery0,battery_table0 = <0x1400 0x1B33 0x1C3B 0x1D08 0x1D78 0x1D92 0x1DA1 0x1DEA 0x1E17 0x1E66 0x1E86 0x1EAF 0x1EE3 0x1F4F 0x1FDA 0x203F 0x20AC 0x2123 0x21A2 0x2230 0x2286 0x2320 0x2373 0x2666>;
		    	battery0,battery_table1 = <0x0 0x66 0x196 0x322 0x4AD 0x7C5 0xB60 0x1087 0x15AE 0x1D69 0x2290 0x27B7 0x2CDE 0x3498 0x39BF 0x3EE6 0x440E 0x4935 0x4E5C 0x5616 0x59B1 0x60E8 0x6400 0x64E6>;
			battery0,battery_table2 = <0x1A2B 0x1215 0x1011 0x0D0E 0x0C0C 0x0B0B 0x0B0B 0x0A0A>;
			battery0,alpha = <0x00CC>;
			battery0,beta = <0x0025>;
			battery0,rs = <0x8052>;
			battery0,rs_value = <0x0050 0x010A 0x3800 0x0048>;
			battery0,vit_period = <0x315A>;
			battery0,volt_cal = <0x8000>;
			battery0,mix_value = <0x0003>;
			battery0,curr_offset = <0x0000>;
			battery0,curr_slope = <0x8080>;
			battery0,topoff_soc = <7 450 150>;
			battery0,temp_std = <25>;
			battery0,temp_offset = <0 11 1 0 8 (-1)>;
			battery0,temp_cal = <0 6 1 11 (-1) 0 6 1 9 1>;
			battery0,ext_temp_cal = <0 2 1 2 1 1 2 3 2 3>;
			battery0,static_scale_soc = <0 991 1000 (-50) 50 1>;
			battery0,tem_poff = <3400 100>;
			battery0,thermal_table = <0x6177 0x60E6 0x604E 0x5FAF 0x5F06 0x5E56 0x5DA3 0x5CEC 0x5C27 0x5B5A
					 0x5A88 0x59AD 0x58C6 0x57D8 0x56E5 0x55E8 0x54E5 0x53CF 0x52B5 0x519B
					 0x506E 0x4F35 0x4E07 0x4CC0 0x4B76 0x4A25 0x48BD 0x475D 0x45F5 0x4477
					 0x4304 0x4175 0x3FDE 0x3E4A 0x3CA2 0x3AF6 0x3945 0x378A 0x35CB 0x33FC
