			strategy_soc_0_to_50 {
				strategy_temp_little_cold =	<4150 19 0 0 0
								 4150 15 0 0 0
								 4480 13 0 0 0
								 4490 10 1 0 0>;
				strategy_temp_cool =		<4150 28 0 0 0
								 4150 25 0 0 0
								 4150 20 0 0 0
								 4490 19 0 0 0
								 4490 15 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_little_cool = 	<4150 41 0 0 0
								 4150 40 0 0 0
								 4150 35 0 0 0
								 4510 33 0 0 0
								 4510 30 0 0 0
								 4510 25 0 0 0
								 4540 22 0 0 0
								 4540 20 0 0 0
								 4540 15 0 0 0
